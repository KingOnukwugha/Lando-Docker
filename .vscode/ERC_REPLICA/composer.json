{
  "name": "drupal/erc-association",
  "description": "A Drupal 7 site for managing client content and providing a custom user experience with integrated modules for SEO and advanced user permissions.",
  "type": "project",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "7.4.*",
    "phpmailer/phpmailer": "^6.0",
    "symfony/yaml": "^3.4",
    "guzzlehttp/guzzle": "^6.0",
    "drupal/pathauto": "^1.3",
    "drupal/ctools": "^1.21"
  },
  "autoload": {
    "psr-4": {
      "Drupal\\": "includes/"
    }
  },
  "repositories": [
    {
    "type": "composer",
    "url": "https://packages.drupal.org/7"
    }
  ],
  "scripts": {
    "post-install-cmd": [
      "chmod -R 777 sites/default/files",
      "chmod -R 777 sites/default/settings.php"
    ]
  },
  "config": {
    "platform": {
      "php": "7.4.0"
    },
    "preferred-install": "auto",
    "optimize-autoloader": true,
    "minimum-stability": "dev",
    "prefer-stable": true
  },
  "extra": {
    "installer-paths": {
      "sites/all/modules/contrib/{$name}": [
        "type:drupal-module"
      ],
      "sites/all/libraries/{$name}": [
        "type:drupal-library"
      ]
    }
  }
}
